# Copie para .env e ajuste. Variáveis EXPO_PUBLIC_* vão para o bundle do app: nunca coloque segredos aqui.

# mock = fixtures locais rotuladas como EXEMPLO (padrão) · api = backend real
EXPO_PUBLIC_API_MODE=mock

# URL do backend quando API_MODE=api. No celular, use o IP da máquina na rede local
# (localhost não funciona); no emulador Android, http://10.0.2.2:<porta>.
EXPO_PUBLIC_API_URL=http://192.168.0.10:5000

# Neon Auth (contas e login). URL PÚBLICA do Neon Auth da branch (sem segredo): copie NEON_AUTH_BASE_URL de
# .env.local (gerado por `neon deploy`/`neon checkout`). Se definida, contas e login usam o Neon Auth.
# Nunca coloque DATABASE_URL aqui: o app não conecta no banco.
EXPO_PUBLIC_NEON_AUTH_URL=
# Origem enviada ao Neon Auth (o app nativo não manda Origin); precisa estar nos domínios confiáveis do Neon.
# `neon neon-auth domain add <origem>`; localhost já é aceito por padrão.
EXPO_PUBLIC_NEON_AUTH_ORIGIN=http://localhost:8081
