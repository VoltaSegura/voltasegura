# Copie para .env e ajuste. Variáveis EXPO_PUBLIC_* vão para o bundle do app: nunca coloque segredos aqui.

# Fonte da consulta de trajetos:
#   mock = fixtures locais rotuladas como EXEMPLO (padrão, também quando a variável está vazia)
#   api  = backend POST /api/consultas (contrato [HIPÓTESE], PL-18; ainda não existe servidor)
#   otp2 = OpenTripPlanner 2 do projeto (só roteamento: trajetos reais; exposição estimada indisponível)
# Valor desconhecido (ex.: "otp") ou modo sem a URL correspondente NÃO cai no mock: a busca mostra
# erro com "Tentar de novo". Reinicie o Expo com `npx expo start -c` depois de mudar estas variáveis.
EXPO_PUBLIC_API_MODE=mock

# URL do backend quando API_MODE=api. No celular, use o IP da máquina na rede local
# (localhost não funciona); no emulador Android, http://10.0.2.2:<porta>.
EXPO_PUBLIC_API_URL=http://192.168.0.10:5000

# Base do OTP2 quando API_MODE=otp2, SEM o caminho /otp/gtfs/v1 (o app acrescenta). Mesma regra de IP:
# no celular, o IPv4 do notebook no Wi-Fi (ipconfig) e o OTP2 escutando na rede local, porta 8080
# (scripts/otp2/README.md). HTTP sem TLS pode ser barrado no aparelho: [EM ABERTO] B-12.
EXPO_PUBLIC_OTP2_URL=http://192.168.0.10:8080

# Neon Auth (contas e login). URL PÚBLICA do Neon Auth da branch (sem segredo): copie NEON_AUTH_BASE_URL de
# .env.local (gerado por `neon deploy`/`neon checkout`). Se definida, contas e login usam o Neon Auth.
# Nunca coloque DATABASE_URL aqui: o app não conecta no banco.
EXPO_PUBLIC_NEON_AUTH_URL=
# Origem enviada ao Neon Auth (o app nativo não manda Origin); precisa estar nos domínios confiáveis do Neon.
# `neon neon-auth domain add <origem>`; localhost já é aceito por padrão.
EXPO_PUBLIC_NEON_AUTH_ORIGIN=http://localhost:8081

# Exposição estimada real (B-30), só com API_MODE=otp2: base da Data API do Neon, SEM barra final (a função é chamada em
# <URL>/rpc/comparar_exposicao). Exige também EXPO_PUBLIC_NEON_AUTH_URL e uma pessoa logada (o app troca a sessão por um
# JWT em /token). Sem qualquer um destes, o app segue "só roteamento". Nunca coloque chaves aqui.
EXPO_PUBLIC_DATA_API_URL=
# Modo de cobertura enviado à função: poligono (padrão) | proxy_pontos [HIPÓTESE: decisão do Lucas pendente].
EXPO_PUBLIC_EXPOSICAO_COBERTURA=poligono
# Diagnóstico (padrão desligado): com 1, o app imprime no console só "[exposicao] <motivo>" quando a exposição não entra
# (sem_sessao, sem_config, entrada_invalida, token_http_<status>, token_invalido, rpc_http_<status>, resposta_invalida,
# tempo_esgotado, erro_rede, cancelado). Nunca imprime geometria, token, cookie, URL nem corpo. Reinicie com `npx expo start -c`.
EXPO_PUBLIC_EXPOSICAO_DIAG=
